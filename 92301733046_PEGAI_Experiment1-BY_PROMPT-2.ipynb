import pygame
import random
import sys

# ----------------------------
# Initialize Pygame
# ----------------------------
pygame.init()

# Screen settings
WIDTH, HEIGHT = 600, 600
GRID_SIZE = 20

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Snake Game")

clock = pygame.time.Clock()

# Colors
BLACK = (20, 20, 20)
GREEN = (0, 220, 0)
RED = (220, 50, 50)
WHITE = (255, 255, 255)
GRAY = (180, 180, 180)

# Fonts
font = pygame.font.SysFont("arial", 28)
large_font = pygame.font.SysFont("arial", 50)


# ----------------------------
# Draw Text
# ----------------------------
def draw_text(text, font, color, x, y, center=False):
    img = font.render(text, True, color)
    rect = img.get_rect()

    if center:
        rect.center = (x, y)
    else:
        rect.topleft = (x, y)

    screen.blit(img, rect)


# ----------------------------
# Generate Food
# ----------------------------
def random_food(snake):
    while True:
        x = random.randrange(0, WIDTH, GRID_SIZE)
        y = random.randrange(0, HEIGHT, GRID_SIZE)

        if (x, y) not in snake:
            return (x, y)


# ----------------------------
# Draw Restart Button
# ----------------------------
def draw_button():
    button = pygame.Rect(WIDTH // 2 - 80, HEIGHT // 2 + 40, 160, 50)

    pygame.draw.rect(screen, GREEN, button, border_radius=8)

    draw_text(
        "Restart",
        font,
        BLACK,
        button.centerx,
        button.centery,
        center=True,
    )

    return button


# ----------------------------
# Main Game Function
# ----------------------------
def game():

    snake = [(300, 300)]
    direction = (GRID_SIZE, 0)

    food = random_food(snake)

    score = 0
    speed = 10

    running = True

    while running:

        # ----------------------------
        # Events
        # ----------------------------
        for event in pygame.event.get():

            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

            if event.type == pygame.KEYDOWN:

                if event.key == pygame.K_UP and direction != (0, GRID_SIZE):
                    direction = (0, -GRID_SIZE)

                elif event.key == pygame.K_DOWN and direction != (0, -GRID_SIZE):
                    direction = (0, GRID_SIZE)

                elif event.key == pygame.K_LEFT and direction != (GRID_SIZE, 0):
                    direction = (-GRID_SIZE, 0)

                elif event.key == pygame.K_RIGHT and direction != (-GRID_SIZE, 0):
                    direction = (GRID_SIZE, 0)

        # ----------------------------
        # Move Snake
        # ----------------------------
        head_x = snake[0][0] + direction[0]
        head_y = snake[0][1] + direction[1]
        head = (head_x, head_y)

        # Collision with wall
        if (
            head_x < 0
            or head_x >= WIDTH
            or head_y < 0
            or head_y >= HEIGHT
        ):
            return score

        # Collision with itself
        if head in snake:
            return score

        snake.insert(0, head)

        # Eat food
        if head == food:
            score += 1

            # Increase speed
            speed = min(25, 10 + score)

            food = random_food(snake)

        else:
            snake.pop()

        # ----------------------------
        # Draw
        # ----------------------------
        screen.fill(BLACK)

        pygame.draw.rect(
            screen,
            RED,
            (food[0], food[1], GRID_SIZE, GRID_SIZE),
            border_radius=4,
        )

        for segment in snake:
            pygame.draw.rect(
                screen,
                GREEN,
                (segment[0], segment[1], GRID_SIZE, GRID_SIZE),
                border_radius=4,
            )

        draw_text(f"Score: {score}", font, WHITE, 10, 10)
        draw_text(f"Speed: {speed}", font, WHITE, 450, 10)

        pygame.display.flip()

        clock.tick(speed)


# ----------------------------
# Game Over Screen
# ----------------------------
def game_over(score):

    while True:

        screen.fill(BLACK)

        draw_text(
            "GAME OVER",
            large_font,
            RED,
            WIDTH // 2,
            170,
            center=True,
        )

        draw_text(
            f"Final Score: {score}",
            font,
            WHITE,
            WIDTH // 2,
            250,
            center=True,
        )

        button = draw_button()

        pygame.display.flip()

        for event in pygame.event.get():

            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

            if event.type == pygame.MOUSEBUTTONDOWN:

                if button.collidepoint(event.pos):
                    return


# ----------------------------
# Main Loop
# ----------------------------
while True:
    final_score = game()
    game_over(final_score)
